// Versioned database schema. Generate and commit migrations whenever this file changes.
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum EncounterStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
  TRANSFERRED
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}
model Role {
  id String @id @default(cuid())
  code String @unique
  nameAr String
  nameEn String
  users User[]
  permissions RolePermission[]
  createdAt DateTime @default(now())
}
model Permission {
  id String @id @default(cuid())
  code String @unique
  description String?
  roles RolePermission[]
  userPermissions UserPermission[]
}
model RolePermission {
  roleId String
  permissionId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}
model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  fullName String
  phone String?
  isActive Boolean @default(true)
  status UserStatus @default(ACTIVE)
  roleId String
  role Role @relation(fields: [roleId], references: [id])
  auditLogs AuditLog[]
  userPermissions UserPermission[]
  scopes UserScope[]
  dashboardPreferences DashboardPreference[]
  preferredLanguage String @default("ar")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Department {
  id String @id @default(cuid())
  code String @unique
  nameAr String
  nameEn String
  isActive Boolean @default(true)
  doctors Doctor[]
  appointments Appointment[]
  patients Patient[]
}
model Doctor {
  id String @id @default(cuid())
  userId String? @unique
  fullName String
  specialty String?
  departmentId String
  department Department @relation(fields: [departmentId], references: [id])
  appointments Appointment[]
  operations Operation[]
}
model Patient {
  id String @id @default(cuid())
  medicalRecordNo String @unique
  nationalId String? @unique
  firstName String
  lastName String
  dateOfBirth DateTime?
  sex String?
  phone String?
  email String?
  address String?
  departmentId String?
  department Department? @relation(fields: [departmentId], references: [id])
  appointments Appointment[]
  operations Operation[]
  encounters Encounter[]
  admissions Admission[]
  prescriptions Prescription[]
  labOrders LabOrder[]
  invoices Invoice[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([lastName, firstName])
  @@index([phone])
}
model Appointment {
  id String @id @default(cuid())
  patientId String
  patient Patient @relation(fields: [patientId], references: [id])
  doctorId String
  doctor Doctor @relation(fields: [doctorId], references: [id])
  departmentId String
  department Department @relation(fields: [departmentId], references: [id])
  startsAt DateTime
  status AppointmentStatus @default(BOOKED)
  reason String?
  createdAt DateTime @default(now())
  @@index([startsAt, departmentId])
}
model Encounter {
  id String @id @default(cuid())
  patientId String
  patient Patient @relation(fields: [patientId], references: [id])
  clinicianId String
  status EncounterStatus @default(OPEN)
  chiefComplaint String?
  diagnosis String?
  clinicalNotes String?
  startedAt DateTime @default(now())
  closedAt DateTime?
}
model Admission {
  id String @id @default(cuid())
  patientId String
  patient Patient @relation(fields: [patientId], references: [id])
  admissionNo String @unique
  status AdmissionStatus @default(ADMITTED)
  admittedAt DateTime @default(now())
  dischargedAt DateTime?
  ward String?
  bedLabel String?
}
model Product {
  id String @id @default(cuid())
  sku String @unique
  nameAr String
  nameEn String
  category ItemCategory @default(CONSUMABLE)
  unit String
  purchasePrice Decimal @default(0) @db.Decimal(14,2)
  sellingPrice Decimal? @db.Decimal(14,2)
  reorderLevel Decimal @default(0) @db.Decimal(12,3)
  isActive Boolean @default(true)
  stockItems StockItem[]
  stockMovements StockMovement[]
  prescriptionItems PrescriptionItem[]
  operationItems OperationItem[]
}
model StockItem {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id])
  batchNo String
  expiryDate DateTime?
  unitCost Decimal @db.Decimal(14,2)
  quantity Decimal @db.Decimal(12,3)
  createdAt DateTime @default(now())
  @@unique([productId, batchNo])
  @@index([expiryDate])
}
model Prescription {
  id String @id @default(cuid())
  patientId String
  patient Patient @relation(fields: [patientId], references: [id])
  prescriberId String
  status OrderStatus @default(NEW)
  items PrescriptionItem[]
  createdAt DateTime @default(now())
}
model PrescriptionItem {
  id String @id @default(cuid())
  prescriptionId String
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  dose String
  frequency String
  duration String?
  quantity Int
}
model LabOrder {
  id String @id @default(cuid())
  patientId String
  patient Patient @relation(fields: [patientId], references: [id])
  requestedById String
  testName String
  status OrderStatus @default(NEW)
  resultText String?
  createdAt DateTime @default(now())
}
model Invoice {
  id String @id @default(cuid())
  patientId String
  patient Patient @relation(fields: [patientId], references: [id])
  invoiceNo String @unique
  status InvoiceStatus @default(DRAFT)
  currency String @default("EGP")
  subtotal Decimal @db.Decimal(12,2)
  discount Decimal @default(0) @db.Decimal(12,2)
  total Decimal @db.Decimal(12,2)
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action String
  entity String
  entityId String?
  ipAddress String?
  beforeData Json?
  afterData Json?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
  @@index([createdAt])
}


enum OperationStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ItemCategory {
  MEDICATION
  CONSUMABLE
  OTHER
}

model OperationType {
  id String @id @default(cuid())
  code String @unique
  nameAr String
  nameEn String
  isDelivery Boolean @default(false)
  isCesarean Boolean @default(false)
  isActive Boolean @default(true)
  operations Operation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Operation {
  id String @id @default(cuid())
  operationNo String @unique
  patientId String
  patient Patient @relation(fields: [patientId], references: [id])
  doctorId String
  doctor Doctor @relation(fields: [doctorId], references: [id])
  operationTypeId String
  operationType OperationType @relation(fields: [operationTypeId], references: [id])
  scheduledAt DateTime
  startedAt DateTime?
  endedAt DateTime?
  status OperationStatus @default(SCHEDULED)
  notes String?
  items OperationItem[]
  consumablesCost Decimal @default(0) @db.Decimal(14,2)
  medicationsCost Decimal @default(0) @db.Decimal(14,2)
  otherCost Decimal @default(0) @db.Decimal(14,2)
  totalCost Decimal @default(0) @db.Decimal(14,2)
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([scheduledAt, doctorId])
  @@index([patientId, scheduledAt])
  @@index([operationTypeId, scheduledAt])
}

model OperationItem {
  id String @id @default(cuid())
  operationId String
  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  productId String?
  product Product? @relation(fields: [productId], references: [id])
  itemNameSnapshot String
  category ItemCategory
  unitSnapshot String
  quantity Decimal @db.Decimal(12,3)
  purchaseUnitPrice Decimal @db.Decimal(14,2)
  sellingUnitPrice Decimal? @db.Decimal(14,2)
  lineCost Decimal @db.Decimal(14,2)
  createdAt DateTime @default(now())
  @@index([operationId])
  @@index([itemNameSnapshot])
}

model UserPermission {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  allowed Boolean @default(true)
  @@unique([userId, permissionId])
}

model UserScope {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource String
  resourceId String
  @@unique([userId, resource, resourceId])
  @@index([resource, resourceId])
}

model DashboardPreference {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  layout Json
  isDefault Boolean @default(false)
  updatedAt DateTime @updatedAt
  @@unique([userId])
}

model SystemSetting {
  key String @id
  value Json
  updatedAt DateTime @updatedAt
}

model StockMovement {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id])
  stockItemId String?
  movementType String
  quantity Decimal @db.Decimal(12,3)
  unitCost Decimal @db.Decimal(14,2)
  referenceType String?
  referenceId String?
  performedById String
  createdAt DateTime @default(now())
  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
}
